# Root .htaccess for redirecting base to /sknscoe/public/
# and disabling directory listing

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # If the request is for the domain root, send to project public dir
  RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^$ /public/ [L,R=302]
</IfModule>
